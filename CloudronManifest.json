  "website": "https://github.com/caleno/kixoff",
  "contactEmail": "lennart.nordgreen@uib.no",
  "changelog": "Initial Cloudron manifest for KIXoff deployment",
  "documentationUrl": "https://github.com/caleno/kixoff#readme",
