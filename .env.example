# ===== KIXoff Environment Variables =====
# Copy to .env and fill in values

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://kixoff:kixoff_pass@localhost:5432/kixoff

# Redis
REDIS_URL=redis://localhost:6379

# JWT (Sentinel: use 256-bit keys in production)
JWT_SECRET=change-me-to-a-256-bit-secret-key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-to-a-different-256-bit-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloduron SSO
CLODURON_SSO_URL=https://sso.cloduron.no
CLODURON_SSO_CLIENT_ID=kixoff
CLODURON_SSO_CLIENT_SECRET=change-me

# Game
TICK_RATE=60
BROADCAST_RATE=20
MATCH_DURATION_MS=180000
MAX_PLAYERS_PER_MATCH=6

# Matchmaking
MM_QUEUE_TIMEOUT_MS=30000
MM_SKILL_BAND=200

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
