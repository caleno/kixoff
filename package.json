{
  "name": "kixoff",
  "version": "0.1.0",
  "private": true,
  "description": "KIXoff — Fast-paced 3v3 real-time multiplayer sports-arcade game for the Cloduron platform",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "vite --config frontend/vite.config.ts",
    "build": "tsc && vite build --config frontend/vite.config.ts",
    "start": "node dist/server.js",
    "lint": "eslint src/ frontend/src/ --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "pg": "^8.12.0",
    "redis": "^4.6.15",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "uuid": "^9.0.1",
    "rate-limiter-flexible": "^5.0.3"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.16.5",
    "vite": "^5.3.5",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.7",
    "framer-motion": "^11.3.8",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
